{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":maintainLockFilesWeekly"
  ],
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Hold Python below 3.15 until Branchwater supports it",
      "matchManagers": ["pixi"],
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.15"
    }
  ]
}
