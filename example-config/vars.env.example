DEBUG=False
SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET_KEY
ALLOWED_HOSTS=mgwatch.example.org
CSRF_TRUSTED_ORIGINS=https://mgwatch.example.org
MGW_URL=https://mgwatch.example.org
TIME_ZONE=Europe/Berlin

# Paths inside the backend containers.
DATA_DIR=/data
DB_DIR=/data-db
LOG_DIR=/logs

# Keep this password synchronized with MGWATCH_MONGO_ROOT_PASSWORD in .env.
MONGO_URI=mongodb://root:CHANGE_ME_LONG_RANDOM_MONGODB_PASSWORD@mgwatch-mongodb:27017/
REDIS_URL=redis://mgwatch-redis:6379/0

INDEX_FROM_SCRATCH=False
INDEX_MAX_SIGNATURES=100000
DELETE_INDEXED_SIGS=False
START_DATE=auto
END_DATE=auto
MAX_DOWNLOADS=1000
INDEX_MIN_ITERATOR=38

CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True
CELERY_TASK_RESULT_TIMEOUT=21600
CELERY_LOCK_TIMEOUT=21600
CELERY_LOCK_BLOCKING_TIMEOUT=60

# Leave EMAIL_HOST empty to use Django's console email backend.
EMAIL_HOST=
EMAIL_PORT=1025
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=mgwatch@example.org

# LDAP/Active Directory settings; leave LDAP_SERVER_URI empty to use local Django users.
LDAP_SERVER_URI=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_ROOT=
LDAP_ATTR_USERNAME=user
LDAP_ATTR_EMAIL=mail

# Login throttling. LDAP may also enforce account lockout, but this protects
# the Django login endpoint and local-auth fallback before/alongside LDAP.
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
AXES_RESET_ON_SUCCESS=True
# mgwatch-proxy is the trusted reverse proxy in this Compose example.
AXES_IPWARE_PROXY_COUNT=1
